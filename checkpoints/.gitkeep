.result-medium-high { background: linear-gradient(135deg, #f7971e, #ffd200) !important; }
.result-medium-low  { background: linear-gradient(135deg, #fbb034, #ffdd00) !important; }
.result-low         { background: linear-gradient(135deg, #e44d26, #f16529) !important; }
